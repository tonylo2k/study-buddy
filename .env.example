# Copy to .env.local and paste your key. Never commit .env.local.
ANTHROPIC_API_KEY=

# A shared secret for the family. Required on any public deployment (Vercel refuses
# to make lessons without it). Leave empty for local use. Make it long: four random words is good.
FAMILY_PASSCODE=

# Optional. Any vision-capable Claude Sonnet model id.
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional. How many animated explainers to make per lesson (1-5, default 4).
# EXPLAINER_CAP=4

# Optional. Only if you route requests through your own gateway.
# ANTHROPIC_BASE_URL=https://api.anthropic.com
